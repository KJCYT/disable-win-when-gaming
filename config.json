    "Shell_TrayWnd",
    "ApplicationFrameWindow",
    "Windows.UI.Core.CoreWindow",
    "Multimedia Class Scheduler"
  ],
  "require_foreground": false,
  "poll_interval": 1.0,
  "block_apps_key": true,
  "swallow_combo_keys": false,
  "pause_minutes": 0,
  "beep": true,
  "hotkeys": {
    "toggle_pause": "ctrl+alt+p",
    "toggle_lock": "ctrl+alt+l",
    "quit": "ctrl+alt+q"
  },
  "log_level": "info"
}